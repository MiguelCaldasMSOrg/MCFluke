<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>MCFluke.Managed</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Managed bindings for the MCFluke Fluke 187 native library.</Description>
    <RepositoryUrl>https://github.com/MiguelCaldasMSOrg/MCFluke</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <Import Project="..\..\eng\MCFluke.Paths.props" />
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\native\MCFluke.Native.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <PrivateAssets>all</PrivateAssets>
      <AdditionalProperties>Platform=x64</AdditionalProperties>
      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
    <None Include="$(MCFlukeNativeBin)mcfluke.dll" Link="mcfluke.dll"
          CopyToOutputDirectory="IfDifferent" CopyToPublishDirectory="PreserveNewest"
          Pack="false" />
  </ItemGroup>
</Project>
