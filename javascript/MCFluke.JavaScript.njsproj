<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">18.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <Import Project="..\eng\MCFluke.Paths.props" />
  <PropertyGroup>
    <BaseOutputPath>$(MCFlukeRoot)out\vs\bin\MCFluke.JavaScript\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MCFlukeRoot)out\vs\obj\MCFluke.JavaScript\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{472A6B12-8A6E-4AAD-B0FD-5194075C9024}</ProjectGuid>
    <ProjectTypeGuids>{3AF33F2E-1136-4D97-BBB7-1795711AC8B8};{9092AA53-FB77-4645-B42D-1CCCA6BD08BD}</ProjectTypeGuids>
    <ProjectHome>.</ProjectHome>
    <StartupFile>examples\read-display.js</StartupFile>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
    <ScriptArguments>--port COM3</ScriptArguments>
    <Environment>MCFLUKE_HOST=$(MCFlukeNativeBin)mcfluke-host.exe</Environment>
    <StartWebBrowser>false</StartWebBrowser>
    <EnableTypeScript>false</EnableTypeScript>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="src\index.js" />
    <Content Include="examples\read-display.js" />
    <Content Include="fixtures\child-fixture.js" />
    <Content Include="test\*.test.js" />
    <Content Include="package.json" />
    <Content Include="README.md" />
    <Folder Include="src\" />
    <Folder Include="examples\" />
    <Folder Include="fixtures\" />
    <Folder Include="test\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\native\MCFluke.Bridge.vcxproj">
      <Project>{D4ECBA9A-5202-493F-8A55-F362E327F842}</Project>
      <Name>MCFluke.Bridge</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <SetConfiguration>Configuration=$(Configuration)</SetConfiguration>
      <SetPlatform>Platform=$(MCFlukeNativePlatform)</SetPlatform>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VSToolsPath)\Node.js Tools\Microsoft.NodejsToolsV2.targets" />
</Project>
