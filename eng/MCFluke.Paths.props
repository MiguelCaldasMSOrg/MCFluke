<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <MCFlukeRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</MCFlukeRoot>
    <MCFlukeNativePlatform Condition="'$(MCFlukeNativePlatform)' == ''">x64</MCFlukeNativePlatform>
    <MCFlukeNativeBin>$([MSBuild]::NormalizeDirectory('$(MCFlukeRoot)', 'out', 'vs', 'bin', '$(MCFlukeNativePlatform)', '$(Configuration)'))</MCFlukeNativeBin>
    <MCFlukeUseVisualStudioNative Condition="'$(OS)' == 'Windows_NT' and '$(MSBuildRuntimeType)' == 'Full'">true</MCFlukeUseVisualStudioNative>
  </PropertyGroup>
</Project>
